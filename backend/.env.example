# 서비스용 LLM: workers_ai(Cloudflare) 또는 ollama(내 컴퓨터, 개발용)
LLM_PROVIDER=workers_ai

# Cloudflare 대시보드 → AI → Workers AI → "Use REST API"에서 확인
CLOUDFLARE_ACCOUNT_ID=
# 같은 화면에서 만든 Workers AI API 토큰. 비밀값이라 git·대화·로그에 올리지 않는다
CLOUDFLARE_API_TOKEN=
# 비우면 기본 모델(@cf/google/gemma-4-26b-a4b-it)
CLOUDFLARE_AI_MODEL=

# LLM_PROVIDER=ollama 일 때만 쓴다
OLLAMA_BASE_URL=http://localhost:11434

# 하루 질문 한도(AI를 부른 질문 기준, UTC 0시 = 한국 09시에 초기화). 무료 AI 한도를 지키는 안전장치
DAILY_ASK_LIMIT=300
DAILY_ASK_LIMIT_PER_IP=40

# 요청 제한 on/off
RATE_LIMIT=on
# 개발 중에만 on: /docs 공개
ENABLE_DOCS=off
