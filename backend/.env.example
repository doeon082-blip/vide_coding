# 공공데이터포털 API 인증키 (Decoding 또는 Encoding 키 모두 가능)
PUBLIC_DATA_API_KEY=your_public_data_api_key_here
PUBLIC_DATA_API_URL=http://api.data.go.kr/openapi/tn_pubr_public_cltur_fstvl_api

# ChromaDB 벡터 DB (기본 저장 위치: backend/chroma_db)
CHROMA_PERSIST_DIR=
CHROMA_COLLECTION_NAME=festivals
# 임베딩 모델(Ollama, 무료). 비우면 Chroma 기본 임베딩 사용
OLLAMA_EMBED_MODEL=qwen3-embedding:4b

# Ollama 로컬 AI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# 서버 / CORS (쉼표로 여러 개)
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,https://your-username.github.io

# 로그 (기본: backend/logs/app.log)
LOG_LEVEL=INFO
LOG_DIR=

# 요청 제한(on/off)
RATE_LIMIT=on

# 한국관광공사 TourAPI(사진). 같은 공공데이터포털 키 사용, '한국관광공사_국문 관광정보 서비스_GW' 활용신청 필요
TOUR_API_URL=https://apis.data.go.kr/B551011/KorService2

# 개발 중에만 on: /docs, /openapi.json 공개
ENABLE_DOCS=off

# TourAPI 하루 호출 예산(개발계정 한도 ~1000건보다 낮게)
TOUR_API_DAILY_BUDGET=800

# 표시할 사진의 공공누리 유형 (1,3유형=상업적 이용 가능)
ALLOWED_PHOTO_LICENSES=Type1,Type3

# 한국체육산업개발 "입출차·공연·날씨" 연계 데이터 (data.go.kr 15164822, 문화공공데이터광장 키). 값은 backend/.env 에만 쓴다
KSPO_API_KEY=your_kspo_api_key_here
KSPO_API_URL=your_kspo_api_endpoint_url_here
