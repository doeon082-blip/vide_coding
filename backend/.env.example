# 채산(로컬 서버)이 읽는 설정. 비밀값(API 키)은 없다 — 데이터는 미리 내려받은 파일이고, LLM은 내 컴퓨터의 Ollama다.
# 실제 값은 .env에 쓰고(git에 올리지 않는다), 이 파일에는 이름과 예시만 둔다.

# Ollama 로컬 AI 주소와 응답 대기 시간(초). 모델 첫 로딩이 느리면 늘린다
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=180

# 채산 API가 허용할 출처(쉼표로 여러 개). 화면과 API가 같은 주소라 보통은 필요 없다
CHAESAN_CORS_ORIGINS=http://localhost:5173

# 요청 제한(on/off)
RATE_LIMIT=on

# 개발 중에만 on: /docs, /openapi.json 공개
ENABLE_DOCS=off
