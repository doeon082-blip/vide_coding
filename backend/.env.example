# 채산 서버가 읽는 설정. 실제 값은 `.env`에 쓰고(git에 올리지 않는다) 이 파일에는 이름과 예시만 둔다.
# 코드가 실제로 읽는 이름만 있다(테스트가 검사). 실행: `uv run --env-file .env uvicorn app.chaesan.local.app:app ...`

# ───────── 직접 입력해야 하는 것 (서비스용 LLM = Cloudflare Workers AI) ─────────
# 어느 LLM을 쓸지: workers_ai(서비스) 또는 ollama(내 컴퓨터, 개발용)
LLM_PROVIDER=workers_ai
# Cloudflare 대시보드 → AI → Workers AI → "Use REST API"에서 확인(영문 소문자·숫자 32자)
CLOUDFLARE_ACCOUNT_ID=
# 같은 화면 "Create a Workers AI API Token"으로 만든 토큰. 비밀값: 절대 git·대화·로그에 올리지 않는다
CLOUDFLARE_API_TOKEN=

# ───────── 기본값으로 충분한 것 (바꾸고 싶을 때만) ─────────
# Workers AI 모델과 응답 대기 시간(초). 비우면 기본값(gemma-4-26b)
CLOUDFLARE_AI_MODEL=
CLOUDFLARE_AI_TIMEOUT=60

# LLM_PROVIDER=ollama 일 때만: 내 컴퓨터의 Ollama 주소와 응답 대기 시간(초)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=180

# 채산 API가 허용할 출처(쉼표로 여러 개). 화면과 API가 같은 주소라 보통은 필요 없다
CHAESAN_CORS_ORIGINS=http://localhost:5173

# 요청 제한(on/off)
RATE_LIMIT=on

# 개발 중에만 on: /docs, /openapi.json 공개
ENABLE_DOCS=off
